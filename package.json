{
  "name": "codehand",
  "version": "0.1.0",
  "description": "Let an AI bot hand coding work to OpenCode on the same computer, via MCP or CLI.",
  "type": "module",
  "license": "MIT",
  "author": "Chidananda Reddy",
  "main": "./dist/cli/main.js",
  "exports": {
    ".": "./dist/cli/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chidanandareddyj/codehand.git"
  },
  "homepage": "https://github.com/Chidanandareddyj/codehand#readme",
  "bugs": {
    "url": "https://github.com/Chidanandareddyj/codehand/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "opencode",
    "coding-agent",
    "cli",
    "grok",
    "ai-bot"
  ],
  "bin": {
    "codehand": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
